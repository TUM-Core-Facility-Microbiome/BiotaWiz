version: 0.1
storage:
  cache:
    blobdescriptor: inmemory
  filesystem:
    rootdirectory: /var/lib/registry
http:
  addr: :50500
  headers:
    X-Content-Type-Options: [nosniff]
auth:
  token:
    realm: "http://localhost:60000/auth"
    service: "Docker registry"
    issuer: "Acme auth server"
    rootcertbundle: "/usr/local/share/ca-certificates/server.crt"
